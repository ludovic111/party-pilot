{
  "manifest_version": 3,
  "name": "BombParty Bot",
  "version": "3.0.0",
  "description": "For educational use only. BombParty (jklm.fun) helper: every language, auto-detected; picks words that complete the bonus alphabet; sub-millisecond reaction.",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {
    "default_title": "BombParty Bot",
    "default_popup": "popup/popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://*.jklm.fun/games/bombparty/*"],
      "js": ["bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.jklm.fun/games/bombparty/*"],
      "js": ["core.js", "bot.js"],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {"resources": ["words/*.txt"], "matches": ["https://*.jklm.fun/*"], "use_dynamic_url": true}
  ]
}
