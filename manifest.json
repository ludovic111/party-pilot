{
  "manifest_version": 3,
  "name": "Party Pilot",
  "version": "4.0.0",
  "description": "For educational use only. Game helper for jklm.fun (BombParty in every language, PopSauce) and krillion.io.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Party Pilot",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.jklm.fun/games/bombparty/*"
      ],
      "js": [
        "bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.jklm.fun/games/bombparty/*"
      ],
      "js": [
        "core.js",
        "bot.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.jklm.fun/games/popsauce/*"
      ],
      "js": [
        "popsauce/bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.jklm.fun/games/popsauce/*"
      ],
      "js": [
        "popsauce/bot.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "words/*.txt"
      ],
      "matches": [
        "https://*.jklm.fun/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://api.anthropic.com/*"
  ]
}
